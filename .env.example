# TRACE-X environment variables  --  PLACEHOLDERS ONLY.
#
# Do NOT put real values in this file and do NOT commit a file with real values.
# Local setup (from the app/ folder, PowerShell):
#     Copy-Item ..\.env.example .env.local
# then edit app/.env.local. Next.js reads it automatically; it must stay git-ignored.

# ---- MySQL (Task 2) -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tracex

# Three different MySQL accounts, created by database/02_access.sql.
# The passwords below are placeholders: use the ones you set in your own MySQL.
DB_ADMIN_USER=tracex_admin_app
DB_ADMIN_PASSWORD=replace_with_your_local_admin_password
DB_INVESTIGATOR_USER=tracex_investigator_app
DB_INVESTIGATOR_PASSWORD=replace_with_your_local_investigator_password
DB_WORKER_USER=tracex_worker_app
DB_WORKER_PASSWORD=replace_with_your_local_worker_password

# Optional tuning (defaults shown). Leave commented out unless you need them.
# DB_POOL_LIMIT=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_ACQUIRE_TIMEOUT_MS=10000

# ---- Qdrant and embeddings ------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tracex_records
# Only needed if your Qdrant requires a key (a local Docker Qdrant does not).
# QDRANT_API_KEY=
# QDRANT_TIMEOUT_MS=10000

# Fixed by the design: 384 dimensions, cosine. Other models are rejected at startup.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional. The ONNX conversion Transformers.js downloads (default shown).
# EMBEDDING_ONNX_MODEL=Xenova/bge-small-en-v1.5
# Optional. Where the model is cached (git-ignored folders only).
# EMBEDDING_CACHE_DIR=
# EMBEDDING_BATCH_SIZE=16

# ---- Indexing worker (Person B, Phase 2) -----------------------------------
# The worker reuses the DB_* (account DB_WORKER_USER) and QDRANT_* / EMBEDDING_* settings above.
# All of these are optional; the defaults are shown.
# WORKER_BATCH_SIZE=10
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_MAX_ATTEMPTS=5
# WORKER_BACKOFF_BASE_MS=1000
# WORKER_BACKOFF_MAX_MS=60000
# Requeue jobs left in 'processing' by a crashed run. Only correct with ONE worker running.
# WORKER_RECOVER_ON_START=true

# ---- Session (Task 3) ------------------------------------------------------
SESSION_SECRET=replace_with_a_long_random_string
