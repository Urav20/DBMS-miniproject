    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "7.30.1"
    }
  }
}
