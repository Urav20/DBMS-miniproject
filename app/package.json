{
  "name": "tracex-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:db": "node --test tests/db/helper.unit.test.mjs",
    "test:db:live": "node --env-file=.env.local --test tests/db/live.test.mjs",
    "test:auth": "node --test tests/auth/auth.unit.test.mjs",
    "test:auth:live": "node --env-file=.env.local --test tests/auth/live.test.mjs",
    "vector:setup": "node --env-file=.env.local ../vector/scripts/setup-collection.mjs",
    "vector:health": "node --env-file=.env.local ../vector/scripts/health.mjs",
    "test:vector": "node --test tests/vector/vector.unit.test.mjs",
    "test:vector:live": "node --env-file=.env.local --test tests/vector/live.test.mjs",
    "worker": "node --env-file=.env.local ../worker/run.mjs",
    "worker:once": "node --env-file=.env.local ../worker/run.mjs --once",
    "test:indexing": "node --test tests/indexing/indexing.unit.test.mjs tests/indexing/sql-contract.unit.test.mjs",
